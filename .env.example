# Archive Center 4.7.0 local runtime example.
# Copy only the keys you need into your real environment; do not commit secrets.

# HTTP
AC_BUILD_VERSION=4.7.0
AC_BIND_ADDR=127.0.0.1:28080
AC_MODE=shadow
AC_ALLOWED_ORIGINS=*

# Store modes:
# - noop
# - fixture_shadow
# - mariadb_shadow
# - mariadb_read_shadow
# - mariadb_authority
AC_STORE_MODE=noop
AC_MARIADB_DSN=
AC_MARIADB_PRODUCT_READ_ENABLED=false
AC_STORE_FIXTURE_DIR=

# Prompt directory used by the editable prompt API/UI.
AC_PROMPT_DIR=./prompts

# Critic prune target handling: soft or off.
AC_PRUNE_POLICY=soft

# ChromaDB is the vector accelerator. Shadow/dev mode may run without an
# endpoint, but live/cutover requires AC_CHROMA_ENDPOINT.
AC_CHROMA_ENDPOINT=
AC_CHROMA_COLLECTION=archive_center_vectors
AC_REFERENCE_CHROMA_COLLECTION=archive_center_reference_vectors
AC_CHROMA_API_PATH=/api/v2

# Historical Chroma shadow parity path. The current product vector path uses
# AC_CHROMA_ENDPOINT above.
AC_CHROMA_SHADOW_PERSIST_DIR=./data/chroma-shadow

# Embedder metadata for preflight/reporting.
#
# These are DECLARATIONS, not the embedding mechanism. The vectors themselves are
# computed by the Host and stored per memory row, so the authoritative record is
# memories.embedding_model and the length of memories.embedding -- which is why
# the admin reindex path compares an expected model against observed ones instead
# of trusting this block.
#
# The model is a per-user setting (RisuAI -> settings -> 기억 색인 LLM), so it
# varies between installations. That matters beyond reporting on the Cloudflare
# profile: the Vectorize index is created with a fixed dimension, and that
# dimension must match whichever model the operator actually uses. See
# deploy/cloudflare/README.md, "Provision the account-scoped resources".
AC_EMBEDDER_PROVIDER=
AC_EMBEDDER_MODEL=
AC_EMBEDDER_ENDPOINT=

# Optional local auth envelope. Off by default.
AC_ENFORCE_AUTH=false
AC_BEARER_TOKEN=

# Optional GitHub update checker. Archive Center checks the latest stable release,
# downloads a package ZIP, verifies SHA256SUMS, and stages it for manual apply.
AC_UPDATE_ENABLED=true
AC_UPDATE_GITHUB_REPO=Flazer31/archive-center
AC_UPDATE_CHANNEL=stable
AC_UPDATE_STAGING_DIR=.updates
AC_UPDATE_MAX_DOWNLOAD_MB=1024
